# Local tip: if host :5432 is already in use, use POSTGRES_PORT=5433 and point DATABASE_URL at 127.0.0.1:5433
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://siteyonetim:change-me@127.0.0.1:5432/siteyonetim
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOG_LEVEL=info
UPLOAD_DIR=./data/uploads
CORS_ORIGIN=http://localhost:5173

KURUM_NAME=Site Yönetim
KURUM_CODE=SY01
KURUM_ADDRESS=
KURUM_TAX_NUMBER=
KURUM_PHONE=
KURUM_EMAIL=

ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-before-first-login
ADMIN_FULL_NAME=Yönetici
