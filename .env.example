# Local tip: if host :5432 is already in use, use POSTGRES_PORT=5433 and point DATABASE_URL at 127.0.0.1:5433
# Shared
POSTGRES_USER=siteyonetim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=siteyonetim
POSTGRES_PORT=5433

# API
API_PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://siteyonetim:change-me@127.0.0.1:5433/siteyonetim
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOG_LEVEL=info
UPLOAD_DIR=./data/uploads
CORS_ORIGIN=http://localhost:8080

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# First admin, created on first start
KURUM_NAME=My Site
KURUM_CODE=SITE01
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-first-login
